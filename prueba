<main>
  <h1>Panel de control</h1>
  <p class="sub">Ajusta las preferencias y guarda los cambios.</p>

  <section>
    <h2>Apariencia</h2>
    <div class="row">
      <div><label for="dark">Modo oscuro</label><small>Cambia los colores de la interfaz</small></div>
      <span class="switch"><input type="checkbox" id="dark"><span class="track"></span></span>
    </div>
    <div class="row">
      <label for="size">Tamaño del texto</label>
      <input type="range" id="size" min="14" max="22" step="1" value="16">
      <span class="val" id="size-v">16 px</span>
    </div>
  </section>

  <section>
    <h2>Sonido</h2>
    <div class="row">
      <label for="sound">Sonido activado</label>
      <span class="switch"><input type="checkbox" id="sound" checked><span class="track"></span></span>
    </div>
    <div class="row">
      <label for="vol">Volumen</label>
      <input type="range" id="vol" min="0" max="100" step="1" value="70">
      <span class="val" id="vol-v">70 %</span>
    </div>
  </section>

  <section>
    <h2>Rendimiento</h2>
    <div class="row">
      <label for="quality">Calidad gráfica</label>
      <select id="quality">
        <option value="baja">Baja</option>
        <option value="media" selected>Media</option>
        <option value="alta">Alta</option>
      </select>
    </div>
    <div class="row">
      <label for="notif">Avisos en pantalla</label>
      <span class="switch"><input type="checkbox" id="notif" checked><span class="track"></span></span>
    </div>
  </section>

  <div class="actions">
    <button type="button" id="reset">Restablecer</button>
    <button type="button" id="save" class="primary">Guardar cambios</button>
  </div>
  <div id="msg" role="status" aria-live="polite"></div>
</main>

<script>
(function(){
  var KEY = "panel-basico";
  var defaults = {dark:false, size:16, sound:true, vol:70, quality:"media", notif:true};
  var $ = function(id){ return document.getElementById(id); };
  var ids = ["dark","size","sound","vol","quality","notif"];

  function load(){
    try { var s = localStorage.getItem(KEY); if (s) return Object.assign({}, defaults, JSON.parse(s)); } catch(e){}
    return Object.assign({}, defaults);
  }
  function read(){
    return {
      dark:$("dark").checked, size:+$("size").value, sound:$("sound").checked,
      vol:+$("vol").value, quality:$("quality").value, notif:$("notif").checked
    };
  }
  function apply(c){
    $("dark").checked = c.dark; $("size").value = c.size; $("sound").checked = c.sound;
    $("vol").value = c.vol; $("quality").value = c.quality; $("notif").checked = c.notif;
    preview();
  }
  function preview(){
    var c = read();
    document.documentElement.setAttribute("data-theme", c.dark ? "dark" : "light");
    document.body.style.fontSize = c.size + "px";
    $("size-v").textContent = c.size + " px";
    $("vol-v").textContent = c.vol + " %";
    $("vol").disabled = !c.sound;
  }
  function say(t){ $("msg").textContent = t; setTimeout(function(){ $("msg").textContent = ""; }, 2500); }

  ids.forEach(function(id){ $(id).addEventListener("input", preview); });

  $("save").addEventListener("click", function(){
    try { localStorage.setItem(KEY, JSON.stringify(read())); say("Cambios guardados"); }
    catch(e){ say("No se pudo guardar en este navegador"); }
  });
  $("reset").addEventListener("click", function(){
    apply(defaults);
    try { localStorage.removeItem(KEY); } catch(e){}
    say("Valores restablecidos");
  });

  apply(load());
})();
</script>
